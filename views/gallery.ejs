<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle || 'Gallery — Nusrat International' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <% cssFiles.forEach(file => { %>
  <link rel="stylesheet" href="/css/<%= file %>" />
  <% }) %>
</head>
<body class="<%= bodyClass || '' %>">
<nav id="navbar">
  <div class="nav-inner">
    <div class="logo">
      <a href="/">
        <img src="https://image2url.com/r2/default/images/1771964863151-2518979a-0fe0-4990-9a1a-9175b88e5ac8.jpg" alt="Nusrat International Logo" onerror="this.style.display='none'" />
        <div class="logo-text"><span>Nusrat International <br /> Nusrat Travels</span></div>
      </a>
    </div>
    <button class="hamburger" id="hamburger" aria-label="Toggle menu"><span></span><span></span><span></span></button>

    <ul class="nav-links" id="nav-links">
      <li><a href="/" class="<%= activePage==='home' ? 'active' : '' %>">Home | হোম</a></li>
      <li><a href="/ticketing">Ticketing | ভ্রমণ</a></li>
      <li><a href="/travel" class="<%= activePage==='travel' ? 'active' : '' %>">Travel | ভ্রমণ</a></li>
      <li><a href="/hajj" class="<%= activePage==='hajj' ? 'active' : '' %>">Hajj | হাজ্জ</a></li>
      <li><a href="/work" class="<%= activePage==='work' ? 'active' : '' %>">Work | কাজ</a></li>
      <li><a href="/contact" class="<%= activePage==='contact' ? 'active' : '' %>">Contact | যোগাযোগ</a></li>
      <li class="has-dropdown" id="aboutDropdown">
        <button class="dropdown-trigger" aria-haspopup="true" aria-expanded="false">About | আমাদের সম্পর্কে <span class="drop-arrow">▾</span></button>
        <ul class="dropdown-menu" role="menu">
          <li role="none"><a href="/about"><span class="dm-text"><strong>About Us</strong><small>Our story & leadership</small></span></a></li>
          <li role="none"><a href="/gallery"><span class="dm-text"><strong>Gallery</strong><small>Photos & memories</small></span></a></li>
          <li role="none"><a href="/employees"><span class="dm-text"><strong>Our Team</strong><small>Meet our employees</small></span></a></li>
          <li role="none"><a href="/about#certifications"><span class="dm-text"><strong>Approvals & Certifications</strong><small>BAIRA · IATA · ATAB · RL-1429</small></span></a></li>
        </ul>
      </li>
    </ul>
  </div>
</nav>

<div class="page-title">
  <span class="ptag">📸 MEMORIES & MOMENTS</span>
  <h1>Our <em>Gallery</em></h1>
  <p>Capturing moments from journeys, pilgrimages, and celebrations with our valued clients.</p>
</div>

<!-- GALLERY GRID -->
<div class="gallery-wrap">
  <div class="gallery-grid">
    <% if (typeof galleryItems !== 'undefined' && galleryItems.length > 0) { %>
      <% galleryItems.forEach(item => { %>
        <div class="gallery-item">
          <img src="<%= item.image %>" alt="<%= item.title || 'Gallery Image' %>">
          <% if (item.caption) { %>
            <div class="gallery-caption"><%= item.caption %></div>
          <% } %>
        </div>
      <% }) %>
    <% } else { %>
      <!-- Default gallery items -->
      <div class="gallery-item">
        <img src="https://picsum.photos/600/400?1" alt="Hajj Group 2025">
        <div class="gallery-caption">Hajj Group 2025</div>
      </div>
      <div class="gallery-item">
        <img src="https://picsum.photos/600/400?2" alt="Umrah Pilgrims">
        <div class="gallery-caption">Umrah Pilgrims</div>
      </div>
      <div class="gallery-item">
        <img src="https://picsum.photos/600/400?3" alt="Travel Team">
        <div class="gallery-caption">Our Travel Team</div>
      </div>
      <div class="gallery-item">
        <img src="https://picsum.photos/600/400?4" alt="Happy Clients">
        <div class="gallery-caption">Happy Clients</div>
      </div>
      <div class="gallery-item">
        <img src="https://picsum.photos/600/400?5" alt="Office Opening">
        <div class="gallery-caption">Office Opening Ceremony</div>
      </div>
      <div class="gallery-item">
        <img src="https://picsum.photos/600/400?6" alt="Award Ceremony">
        <div class="gallery-caption">Award Ceremony 2024</div>
      </div>
    <% } %>
  </div>
</div>

<footer>
  <div class="footer-inner">
    <div class="footer-brand">
      <div class="footer-logo-container">
        <a href="/" class="footer-logo-link">
          <img src="https://image2url.com/r2/default/images/1771964863151-2518979a-0fe0-4990-9a1a-9175b88e5ac8.jpg" alt="Logo" class="footer-logo-img" onerror="this.style.display='none'" />
          <span class="footer-logo-text">Nusrat International</span>
        </a>
      </div>
      <p>Your trusted partner for Hajj, Umrah, travel & work. Serving Bangladesh since 2010.</p>
      <div class="social-links"><a href="#">FB</a><a href="#">YT</a><a href="#">IG</a><a href="#">WA</a></div>
    </div>
    <div class="footer-links"><h4>Services</h4><a href="/travel">Travel Packages</a><a href="/hajj">Hajj Packages</a><a href="/hajj">Umrah Packages</a><a href="/work">Work Visas</a></div>
    <div class="footer-links"><h4>Company</h4><a href="/about">About Us</a><a href="/employees">Our Team</a><a href="/testimonials">Testimonials</a><a href="/contact">Contact</a></div>
    <div class="footer-links">
      <h4>Our Location</h4>
      <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3650.7194346099836!2d90.4049653103119!3d23.79300323072133!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3755c70e90bb671d%3A0x7eab77d0896252c0!2sBanani%20Super%20Market!5e0!3m2!1sen!2sbd!4v1771968108612!5m2!1sen!2sbd" width="100%" height="200" class="footer-iframe" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </div>
  <div class="footer-bottom"><p>© 2026 Nusrat International Bangladesh. All rights reserved. | সর্বস্বত্ব সংরক্ষিত।</p></div>
</footer>

<script>
const hamburger=document.getElementById('hamburger'),navLinks=document.getElementById('nav-links'),navItems=navLinks.querySelectorAll('li'),aboutDD=document.getElementById('aboutDropdown'),dropTrig=aboutDD.querySelector('.dropdown-trigger');
function openMenu(){hamburger.classList.add('open');navLinks.classList.add('open');document.body.classList.add('menu-open');navItems.forEach((item,i)=>{item.style.transitionDelay=`${0.06+i*0.07}s`;setTimeout(()=>item.classList.add('revealed'),20)});}
function closeMenu(){hamburger.classList.remove('open');navLinks.classList.remove('open');document.body.classList.remove('menu-open');navItems.forEach(item=>{item.classList.remove('revealed');item.style.transitionDelay='0s';});aboutDD.classList.remove('mobile-open');dropTrig.setAttribute('aria-expanded','false');}
hamburger.addEventListener('click',e=>{e.stopPropagation();hamburger.classList.contains('open')?closeMenu():openMenu();});
document.querySelectorAll('.nav-links a').forEach(l=>l.addEventListener('click',closeMenu));
document.addEventListener('click',e=>{if(navLinks.classList.contains('open')&&!navLinks.contains(e.target)&&!hamburger.contains(e.target))closeMenu();});
dropTrig.addEventListener('click',function(e){if(window.innerWidth<=768){e.preventDefault();e.stopPropagation();aboutDD.classList.toggle('mobile-open');this.setAttribute('aria-expanded',aboutDD.classList.contains('mobile-open'));}});
</script>
<script src="/js/common.js"></script>
</body>
</html>
